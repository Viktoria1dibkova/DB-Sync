<Window x:Class="КР.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:КР"
        mc:Ignorable="d"
        Title="Склад: два филиала" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Работает на:"  FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            <RadioButton x:Name="RadioMain" Content="Филиал 1 (maindb)" IsChecked="True"  Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Click="Branch_Click"/>
            <RadioButton x:Name="RadioClient" Content="Филиал 2 (clientb)" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Click="Branch_Click"/>
        </StackPanel>
        <TabControl Grid.Row="1" FontSize="15">
            <TabItem Header="Товары">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridProducts" AutoGenerateColumns="True" IsReadOnly="True"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Артикул:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="TxtArticle" Width="80" Margin="10,0,10,0"/>
                        <TextBlock Text="Название:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtName" Width="180" Margin="10,0,10,0"/>
                        <TextBlock Text="Цена:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPrice" Width="100" Margin="10,0,10,0"/>
                        <Button Content="Добавить товар" Padding="10,5" FontWeight="Bold" Click="AddProduct_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Движения">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridMoves" AutoGenerateColumns="True" IsReadOnly="True"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Товар:" VerticalAlignment="Center" Margin="1,0,0,0"/>
                        <ComboBox x:Name="ComboProducts" Width="190" Margin="10,0,10,0" DisplayMemberPath="label" SelectedValuePath="id"/>
                        <TextBlock Text="Операция:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboMoveType" Width="80" Margin="10,0,10,0">
                            <ComboBoxItem Content="Приход" IsSelected="True"/>
                            <ComboBoxItem Content="Расход"/>
                        </ComboBox>
                        <TextBlock Text="Кол-во:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQty" Width="60" Margin="10,0,10,0"/>
                        <Button Content="Провести операцию" Padding="10,5" FontWeight="Bold" Click="AddProduct_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <Button Content="Синхронизировать филиалы" Width="230" Height="34" FontWeight="Bold" FontSize="15"/>
            <TextBlock x:Name="StatusText" Text="Готово к работе" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
